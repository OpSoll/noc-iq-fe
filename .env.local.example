# NOC IQ Frontend — Local Environment Configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should NEVER be committed.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are server-side only.

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------
# Base URL of the noc-iq-be backend API.
# Default for local development: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
