# NOC IQ Frontend — Local Environment Configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should NEVER be committed.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are server-side only.

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------
# Base URL of the noc-iq-be backend API.
# Default for local development: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
# Set to "true" or "1" to enable feature flags. Unknown flags default to false.
# NEXT_PUBLIC_FLAG_ADMIN_ERROR_BUDGET=true
# NEXT_PUBLIC_FLAG_OTEL_TRACING=true
# NEXT_PUBLIC_FLAG_COMPARE_MODE=true

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
# Enable route-level span instrumentation (requires OTEL collector)
# NEXT_PUBLIC_OTEL_ENABLED=true
